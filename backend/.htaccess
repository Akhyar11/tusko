# =============================================================================
# Tusko Backend — Akses Laravel dari subfolder Hostinger (shared hosting)
# =============================================================================
# Aplikasi Laravel berada di `public_html/backend`. Berkas ini membuat aplikasi
# dapat diakses langsung di https://<domain>/backend/... (tanpa `/public`),
# dengan entry point `index.php` di root aplikasi.
#
# Kenapa entry point di root? Karena request diteruskan ke `public/index.php`
# membuat Laravel melihat base URL `/backend/public` sehingga path info menjadi
# `/backend/api/...` (routing 404). Dengan `backend/index.php`, base URL = `/backend`.
#
# Berkas internal (`.env`, `vendor`, `database`, log, dll) tetap ditolak.
# =============================================================================

Options -MultiViews -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Teruskan header Authorization & XSRF ke PHP (wajib untuk Sanctum bearer token).
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Tolak akses langsung ke berkas/direktori internal Laravel (pertahanan berlapis).
    RewriteRule ^(\.env.*|composer\.(json|lock)|artisan|phpunit\.xml|server\.php)$ - [F,L]
    RewriteRule ^(app|bootstrap|config|database|deploy|resources|routes|tests|vendor)/ - [F,L]

    # Entry point root dibiarkan apa adanya.
    RewriteRule ^index\.php$ - [L]

    # Sajikan berkas statis dari `public/` (mis. `/storage/...` via symlink, favicon).
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{DOCUMENT_ROOT}/backend/public/$1 -f
    RewriteRule ^(.*)$ public/$1 [L]

    # Sisanya -> entry point root `index.php` (base URL tanpa `/public`).
    RewriteRule ^ index.php [L]
</IfModule>

# Larang akses berkas sensitif walau mod_rewrite dimatikan.
<FilesMatch "(^\.env|\.(sqlite|sqlite3|log|pem|key)$)">
    Require all denied
</FilesMatch>
